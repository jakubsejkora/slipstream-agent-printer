{
  "name": "slipstream",
  "productName": "Slipstream",
  "version": "0.1.0",
  "private": true,
  "description": "Print your todos as designed thermal slips.",
  "main": "./out/main/index.js",
  "author": "Slipstream",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "render:samples": "pnpm samples",
    "dist:dir": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist": "electron-vite build && electron-builder --mac",
    "samples": "SLIP_OUT_DIR=out-samples electron-vite build && electron out-samples/main/index.js --render-samples",
    "samples:check": "SLIP_OUT_DIR=out-samples electron-vite build && electron out-samples/main/index.js --render-samples --check",
    "dev:mock": "SLIPSTREAM_TRANSPORT=mock electron-vite dev"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "i18next": "^27.1.1",
    "i18next-icu": "^2.7.0",
    "intl-messageformat": "^12.1.5",
    "qrcode": "^1.5.4",
    "ulid": "^3.0.2",
    "usb": "^3.3.0",
    "zod": "^4.6.7",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^24.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.73.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
